# =====================================================================
# PLANTILLA DE CONFIGURACIÓN - INTEGRACIÓN ETL BUK -> SPI (.env.example)
# =====================================================================

# 1. Parámetros de la Aplicación
APP_NAME="ETL BUK-SPI DevSecOps"
APP_VERSION="1.0.0"
APP_ENV="development"
APP_HOST="127.0.0.1"
APP_PORT=8000
DEBUG=True
WORKERS_COUNT=2

# 2. Secreto Criptográfico Webhook BUK
BUK_WEBHOOK_SECRET="S3cr3t0_SuP3r_S3gur0_HMAC_2026_!"
BUK_API_BASE_URL="https://alfonzorivas.buk.co/api/v1/colombia"
BUK_API_TOKEN="TU_TOKEN_DE_API_BUK"

# 3. SQL Server (ODS / Staging)
SQLSERVER_DRIVER="{ODBC Driver 17 for SQL Server}"
SQLSERVER_HOST="localhost\\SQLEXPRESS"
SQLSERVER_PORT=1433
SQLSERVER_DATABASE="ETL_BUK_SPI"
SQLSERVER_USER="sa"
SQLSERVER_PASSWORD="TuPasswordSeguroSQL"
SQLSERVER_POOL_SIZE=10
SQLSERVER_MAX_OVERFLOW=5

# 4. Oracle DB (SPI / Infocent)
ORACLE_MOCK=True
ORACLE_HOST="192.168.1.50"
ORACLE_PORT=1521
ORACLE_SERVICE_NAME="SPIPROD"
ORACLE_USER="SPI_ETL_USER"
ORACLE_PASSWORD="TuPasswordSeguroOracle"
ORACLE_POOL_SIZE=5
ORACLE_MAX_OVERFLOW=5

# 5. Auditoría e InfoTypes SPI
ETL_USER="ETL"
ETL_ID_CAMBIO="10001"
ETL_OBSERVA="CREADO POR ETL"
SPI_DEFAULT_COUNTRY="VEN"
SPI_DEFAULT_MOTIVO="NI"
SPI_MAX_PUESTO_LEN=36

# 6. Notificaciones SMTP
SMTP_HOST="aspmx.l.google.com"
SMTP_PORT=25
SMTP_USER="svc_etl_notifications@alfonzorivas.com"
SMTP_PASSWORD=""
SMTP_FROM="svc_etl_notifications@alfonzorivas.com"
SMTP_USE_TLS=False

# 7. Matriz de Enrutamiento de Correos
MAIL_TO_DEV="lmorales@alfonzorivas.com"
MAIL_TO_CAPITAL_HUMANO="capital_humano@alfonzorivas.com"
MAIL_TO_NOMINA_CARACAS="nomina_caracas@alfonzorivas.com"
MAIL_TO_NOMINA_TURMERO="nomina_turmero@alfonzorivas.com"
